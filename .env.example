# ---------------------------------------------------------------------------
# Environment variables for The Her Tribe
#
# Local dev: copy this file to .env.local and fill in the values.
# Vercel: add each variable under Project -> Settings -> Environment Variables,
# then redeploy. NEXT_PUBLIC_* values are exposed to the browser; the rest stay
# server-only.
# ---------------------------------------------------------------------------

# --- Contact + newsletter (Resend) -----------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL="The Her Tribe <hello@thehertribe.com>"
CONTACT_TO_EMAIL=thehertribe@gmail.com
RESEND_AUDIENCE_ID=

# --- Content CMS (GoDaddy / WordPress, headless) ---------------------------
# WordPress is the CMS for ALL content: blog posts + mentors, workshops, and
# Tribe Talk. The Next.js site reads it via the WP REST API and falls back to
# the in-code content in src/lib/content.ts until each type is set up in WP.
WORDPRESS_API_URL=https://thehertribe.com/wp-json/wp/v2
# Set to false to disable WordPress entirely (use in-code/Sanity fallback).
WORDPRESS_ENABLED=true
#
# WordPress setup required for the structured pages (one-time, in wp-admin):
#   Plugins: "Custom Post Type UI" + "Advanced Custom Fields" (ACF).
#   For every Custom Post Type: enable "Show in REST API".
#   For every ACF field group: enable "Show in REST API" so fields appear
#   under the `acf` key in the REST response.
#
#   1) Mentors  — CPT key: `mentor`   (REST: /wp/v2/mentor)
#        title         -> mentor name
#        featured image-> photo
#        ACF text  `role`
#        ACF textarea `bio`
#   2) Workshops — CPT key: `workshop` (REST: /wp/v2/workshop)
#        title         -> workshop title
#        featured image-> cover image
#        ACF text  `subtitle`
#        ACF text  `price`        (defaults to "Free" if empty)
#        ACF textarea `description`
#   3) Tribe Talk — CPT key: `tribe_talk` (REST: /wp/v2/tribe_talk)
#        title         -> session topic
#        ACF text  `speaker`
#        ACF text  `youtube_id`   (just the ID, e.g. dQw4w9WgXcQ)
#        ACF date  `session_date` (return format: F j, Y)
#   Ordering uses each post's "Order" (menu_order) field, ascending.

# --- Blog (Sanity CMS fallback) --------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
