# ---------------------------------------------------------------------------
# Environment variables for The Her Tribe
#
# Local dev: copy this file to .env.local and fill in the values.
# Vercel: add each variable under Project -> Settings -> Environment Variables,
# then redeploy. NEXT_PUBLIC_* values are exposed to the browser; the rest stay
# server-only.
# ---------------------------------------------------------------------------

# --- Contact + newsletter (Resend) -----------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL="The Her Tribe <hello@thehertribe.com>"
CONTACT_TO_EMAIL=thehertribe@gmail.com
RESEND_AUDIENCE_ID=

# --- Content CMS (GoDaddy / WordPress, headless) ---------------------------
# WordPress is the CMS for ALL content: blog posts + mentors, workshops, and
# Tribe Talk. The site reads the WP REST API and falls back to the in-code
# content in src/lib/content.ts until the matching category/posts exist.
WORDPRESS_API_URL=https://cms.thehertribe.com/wp-json/wp/v2
# Set to false to disable WordPress entirely (use in-code/Sanity fallback).
WORDPRESS_ENABLED=true
#
# No plugins needed. Mentors / Workshops / Tribe Talk are ordinary WordPress
# POSTS filed under a dedicated CATEGORY (create the category, then add posts):
#
#   Category "mentors"
#     Title          -> mentor name
#     Featured image -> photo
#     Excerpt        -> role (e.g. "Financial Expert")
#     Body/content   -> bio
#
#   Category "workshops"
#     Title          -> workshop title
#     Featured image -> cover image
#     Excerpt        -> subtitle
#     Body/content   -> description
#     (price always shows as "Free")
#
#   Category "tribe-talk"
#     Title          -> session topic
#     Excerpt        -> speaker name
#     Body/content   -> paste the YouTube link (watch/youtu.be/embed); the ID
#                       is auto-detected
#     (date uses the post's published date)
#
# These three categories are automatically excluded from the blog list.

# --- Blog (Sanity CMS fallback) --------------------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
