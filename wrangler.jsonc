{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-her-tribe",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "preview_urls": true,
  // Custom domains. Each apex/www must have its OLD (WordPress) DNS record
  // removed first, or provisioning errors with "record already exists".
  "routes": [
    { "pattern": "thehertribe.com", "custom_domain": true },
    { "pattern": "www.thehertribe.com", "custom_domain": true }
  ],
  "vars": {
    "WORDPRESS_API_URL": "https://cms.thehertribe.com/wp-json/wp/v2",
    "WORDPRESS_ENABLED": "true",
    "CONTACT_TO_EMAIL": "thehertribe@gmail.com",
    "RESEND_FROM_EMAIL": "The Her Tribe <hello@thehertribe.com>"
  },
  "observability": {
    "enabled": true
  }
  // For live WordPress updates (ISR / `revalidate`), create an R2 bucket and
  // bind it here, then enable r2IncrementalCache in open-next.config.ts:
  // "r2_buckets": [
  //   { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "the-her-tribe-cache" }
  // ]
}
